+def _part_of_a_longer_stretch(pick: IntroSegment, candidates: Sequence[IntroCandidate]) -> bool:
+    """Whether a stretch two or more other episodes share runs straight on from the pick (overlapping it or within the
+    gap bridge) for at least a run's length past it: the pick is then part of a longer shared stretch cut differently
+    in each episode, a title sequence re-cut to each episode's guest list (Evil S04: the crew half every episode
+    shares, the cast half only some). Half of it would be a wrong answer; none is the honest one."""
+    for other in candidates:
+        seg = other.segment
+        if seg.support < 2 or seg.start_s > pick.end_s + MAX_GAP_S or seg.end_s < pick.start_s - MAX_GAP_S:
+            continue
+        if seg.start_s < pick.start_s - MIN_RUN_S or seg.end_s > pick.end_s + MIN_RUN_S:
+            return True
+    return False
