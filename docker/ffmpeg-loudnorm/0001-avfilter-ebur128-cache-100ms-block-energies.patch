+/* Forget the cached energy of every 100 ms block the next write of frames touches. */
+static void ebur128_invalidate_blocks(FFEBUR128State *st, size_t frames)
+{
+    size_t first = st->d->audio_data_index / st->channels;
+    size_t i;
+
+    if (!frames)
+        return;
+    for (i = first / st->d->samples_in_100ms * st->channels;
+         i < ((first + frames - 1) / st->d->samples_in_100ms + 1) * st->channels; ++i)
+        st->d->block_energy[i] = -1.0;
+}
