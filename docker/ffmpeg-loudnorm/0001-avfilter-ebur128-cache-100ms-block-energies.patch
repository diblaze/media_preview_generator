+static double ebur128_sum_squares(FFEBUR128State *st, size_t c,
+                                  size_t from, size_t to)
+{
+    double sum = 0.0;
+    size_t i;
+
+    for (i = from; i < to; ++i)
+        sum += st->d->audio_data[i * st->channels + c] *
+               st->d->audio_data[i * st->channels + c];
+    return sum;
+}
+
+/* Sum of squares of channel c over ring frames [from, to) (no wrap): whole
+ * 100 ms blocks come from the cache, so a 3 s window costs 30 additions
+ * instead of a pass over every sample; partial blocks at the edges are summed. */
+static double ebur128_window_sum(FFEBUR128State *st, size_t c,
+                                 size_t from, size_t to)
+{
+    const size_t block = st->d->samples_in_100ms;
+    double sum = 0.0;
+
+    while (from < to) {
+        size_t start = from / block * block;
+        size_t end = FFMIN(start + block, to);
+
+        if (from == start && end == start + block) {
+            double *energy = &st->d->block_energy[from / block * st->channels + c];
+            if (*energy < 0.0)
+                *energy = ebur128_sum_squares(st, c, from, end);
+            sum += *energy;
+        } else {
+            sum += ebur128_sum_squares(st, c, from, end);
+        }
+        from = end;
+    }
+    return sum;
+}
